params {
    outdir = './results/'
    mode = 'grid'  // 'grid' | 'train'
    transfer_mode = 'scratch'  // used by mode=train: scratch | head_only | partial
    checkpoint_results_dir = ''
    checkpoint_fold = 0
    folds = 10
    best_params_dir = ''
    grid_params_dir = ''  // legacy alias of best_params_dir
    slides_dir = ''
    heatmap = false  // true: PNG heatmaps + TIFF; false: attention scores only
    // Always point at histomil-mil. Do NOT fall back to CONDA_PREFIX:
    // launching Nextflow from nextflow_env would otherwise poison PATH.
    conda_env = System.getenv('HISTOMIL_ENV') ?: "${System.getenv('HOME')}/micromamba/envs/histomil-mil"
}
process {
    // Force the histomil-mil interpreter; ignore ~/.local user-site packages.
    beforeScript = """
        export PATH="${params.conda_env}/bin:\$PATH"
        export PYTHONNOUSERSITE=1
        export CONDA_PREFIX="${params.conda_env}"
        unset PYTHONPATH
        python -c "import sys; assert sys.implementation.name == 'cpython', f'histomil-mil must be CPython, got {sys.implementation.name} at {sys.executable}'"
    """.stripIndent().trim()

    withName: "split_dataset" {
        memory = "50G"
        cpus = 16
    }
    withName: "grid_search|train" {
        memory = "10G"
        cpus = 8
        //maxForks = 2
        clusterOptions = '--gres=gpu:1 --exclude=wuruwe'
        maxRetries = 3
        cache="lenient"
    }
    withName: "predict" {
        memory = "40G"
        cpus = 8
        clusterOptions = '--gres=gpu:1 --exclude=wuruwe'
        //maxForks = 2
        maxRetries = 3
        cache="lenient"
    }
    withName: "heatmap" {
        memory = { 20.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 4
        cpus = 2
    }
    withName: "convert_tiff" {
        memory = { 20.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 4
        cpus = 2
        container = "oras://community.wave.seqera.io/library/gdal:3.12.1--657539b5002ba0b3"
    }
    withName: "concat_results" {
        memory = "5G"
        cpus = 2
    }
    withName: "boxplot_auc" {
        container = "oras://community.wave.seqera.io/library/r-ggplot2_r-tidyverse:12aafae3063e7f64"
        memory = "1G"
        cpus = 1
    }
    withName: "roc_auc_curve" {
        container = "oras://community.wave.seqera.io/library/r-ggplot2_r-tidyverse:12aafae3063e7f64"
        memory = "1G"
        cpus = 1
    }
}

profiles {
    kutral {
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = true
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        process.executor = 'slurm'
        process.queue = 'ngen-ko'
        process.clusterOptions = "--exclude=host55"
    }
    local {
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    stub {
        process {
            withName: '.*' {
                cpus   = 1
                memory = '1 MB'
                time   = '5 min'
            }
        }
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
    }
}
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
manifest {
    defaultBranch = 'main'
    author = 'Gabriel Cabas'
    version = '0.0.1'
}
