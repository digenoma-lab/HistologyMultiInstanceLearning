params {
    outdir = './results/'
}
process{
    withName: "split_dataset" {
        memory = "60G"
        cpus = 16
        container = "${projectDir}/singularity/histomil.sif"
    }
    withName: "grid_search" {
        memory = "80G"
        cpus = 16
        clusterOptions = "--gres=gpu:1 --exclude=wuruwe"
        container = "${projectDir}/singularity/histomil.sif"
    }
    withName: "predict" {
        memory = "20G"
        cpus = 4
        clusterOptions = "--gres=gpu:1 --exclude=wuruwe"
        container = "${projectDir}/singularity/histomil.sif"
    }
    withName: "heatmap" {
        memory = { 20.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 4
        cpus = 2
        container = "${projectDir}/singularity/histomil.sif"
    }
    withName: "convert_tiff" {
        memory = { 20.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 4
        cpus = 2
        //container = "oras://community.wave.seqera.io/library/libvips:8.17.3--73bbb05066bc0731"
        //container = "oras://community.wave.seqera.io/library/gdal:3.12.1--657539b5002ba0b3"
        container = "oras://community.wave.seqera.io/library/gdal:3.12.1--657539b5002ba0b3"
    }
    withName: "convert_pyramid" {
        memory = { 10.GB * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 4
        cpus = 1
        container = "oras://community.wave.seqera.io/library/bftools:8.0.0--99f8a7708d0a1183"
	    clusterOptions = "--exclude=toki-hm-1"
    }
    withName: "concat_results" {
        memory = "5G"
        cpus = 2
    }
    withName: "boxplot_auc" {
        container = "oras://community.wave.seqera.io/library/r-ggplot2_r-tidyverse:12aafae3063e7f64"
        memory = "1G"
        cpus = 1
    }
    withName: "roc_auc_curve" {
        container = "oras://community.wave.seqera.io/library/r-ggplot2_r-tidyverse:12aafae3063e7f64"
        memory = "1G"
        cpus = 1
    }
}
profiles {
    kutral {
        singularity.enabled     = true
        singularity.autoMounts  = true
	    singularity.runOptions = ' --bind /mnt/beegfs/labs/ --nv'
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        process.executor = 'slurm'
        process.queue = 'ngen-ko'
        executor.queueSize = 20  // Maximum jobs in SLURM queue
    }
    local {
        singularity.enabled     = true
        singularity.autoMounts  = true
	    singularity.runOptions = ' --bind /mnt/beegfs/labs/ '
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    stub {

        process {
            withName: '.*' {
                cpus   = 1
                memory = '1 GB'
                time   = '5 min'
            }
        }
        docker.enabled = false
        singularity.enabled = false
        conda.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
        apptainer.enabled = false
    }
}
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
manifest {
    defaultBranch = 'main'
    author = 'Gabriel Cabas'
    version = '0.0.1'
}